---
import { demoHref } from '../config/site';
---

<section id="inicio" class="hero grain relative isolate flex min-h-[100svh] items-center overflow-hidden bg-ink-900 pt-32 pb-28 text-white">
  <!-- Fondo: el "río" del logo dibujándose, resplandores y rombos flotando -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 right-[-10%] size-[46rem] rounded-full bg-turq-400/20 blur-[120px]"></div>
    <div class="absolute bottom-[-20%] left-[-10%] size-[36rem] rounded-full bg-turq-600/25 blur-[120px]"></div>
    <svg class="hero-river absolute inset-0 h-full w-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
      <defs>
        <linearGradient id="river-g" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2CD8CC" />
          <stop offset=".5" stop-color="#25C5C0" />
          <stop offset="1" stop-color="#18A0AE" />
        </linearGradient>
      </defs>
      <path class="river-path" d="M1500 40 C 1120 60, 760 120, 820 300 S 1340 520, 1080 720 S 520 860, 180 980" stroke="url(#river-g)" stroke-width="150" stroke-linecap="round" opacity=".13" />
      <path class="river-path" d="M1500 40 C 1120 60, 760 120, 820 300 S 1340 520, 1080 720 S 520 860, 180 980" stroke="url(#river-g)" stroke-width="3" stroke-linecap="round" opacity=".55" />
      <path class="river-path" d="M-60 260 C 240 200, 420 330, 380 470 S 120 700, 420 860" stroke="url(#river-g)" stroke-width="2" stroke-dasharray="2 14" stroke-linecap="round" opacity=".5" />
    </svg>
    <i class="diamond hero-diamond absolute top-[18%] left-[8%] animate-float opacity-70" style="--size:22px"></i>
    <i class="diamond hero-diamond absolute top-[70%] left-[46%] animate-float opacity-50 [animation-delay:-2s]" style="--size:14px"></i>
    <i class="diamond hero-diamond absolute top-[12%] right-[30%] animate-float opacity-40 [animation-delay:-4s]" style="--size:10px"></i>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,var(--color-ink-900)_100%)]"></div>
  </div>

  <div class="mx-auto grid w-full max-w-6xl items-center gap-14 px-5 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      <p class="eyebrow hero-in mb-6 rounded-full border border-turq-400/30 bg-turq-400/10 px-3 py-1.5 text-turq-300">
        <i class="diamond" style="--size:7px"></i> Votaciones para asambleas<span class="hidden sm:inline">&nbsp;de propiedad horizontal</span>
      </p>

      <h1 class="font-display text-[clamp(2.7rem,6.2vw,5.5rem)] leading-[0.94] font-extrabold">
        <span class="split-line"><span class="hero-line inline-block">Tu asamblea vota</span></span><br />
        <span class="split-line"><span class="hero-line inline-block">en <span class="text-gradient">minutos,</span></span></span><br />
        <span class="split-line"><span class="hero-line inline-block">no en <span class="strike relative inline-block text-white/45">horas<span aria-hidden="true" class="strike-bar absolute top-[54%] left-[-4%] h-[0.09em] w-[108%] origin-left rounded-full bg-clay-500"></span></span>.</span></span>
      </h1>

      <p class="hero-in mt-7 max-w-xl text-lg leading-relaxed text-white/70 sm:text-xl">
        Quórum en tiempo real, voto por coeficiente desde el celular con un QR y resultados al instante.
        Sin alquilar controles, sin contar manos, sin Excel.
      </p>

      <div class="hero-in mt-9 flex flex-wrap items-center gap-3">
        <a href={demoHref()} class="btn btn-primary text-base">
          Pide una demo
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="#simulador" class="btn btn-ghost-dark text-base">Simula una votación</a>
      </div>

      <ul class="hero-in mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-white/60">
        <li class="flex items-center gap-2"><span class="text-turq-400">✓</span> Desde $50.000 por asamblea</li>
        <li class="flex items-center gap-2"><span class="text-turq-400">✓</span> Sin instalar apps</li>
        <li class="flex items-center gap-2"><span class="text-turq-400">✓</span> Presencial, virtual o mixta</li>
      </ul>
    </div>

    <!-- Maqueta: celular votando + tarjeta de resultados en vivo -->
    <div class="hero-visual relative mx-auto w-full max-w-[25rem]" aria-hidden="true">
      <div class="hero-phone relative mx-auto w-[17.5rem] rounded-[2.6rem] border border-white/15 bg-gradient-to-b from-white/15 to-white/5 p-2.5 shadow-[0_40px_80px_-30px_rgb(0_0_0/0.8)] backdrop-blur">
        <div class="overflow-hidden rounded-[2.1rem] bg-paper text-ink-900">
          <div class="flex items-center justify-between px-5 pt-3 pb-2 font-mono text-[10px] font-semibold text-ink-900/70">
            <span>7:42</span><span class="h-4 w-16 rounded-full bg-ink-900"></span><span>100%</span>
          </div>
          <div class="px-5 pb-5">
            <p class="font-mono text-[10px] font-semibold tracking-widest text-turq-700 uppercase">Punto 4 de 7</p>
            <p class="font-display mt-1 text-xl leading-tight font-bold">¿Aprueba el presupuesto 2027?</p>
            <p class="mt-1 text-xs text-ink-900/65">Torre 2 · Apto 804 · coef. 0,612%</p>
            <div class="mt-4 space-y-2" id="hero-options">
              <div class="hero-opt flex items-center justify-between rounded-2xl border-2 border-ink-900/10 px-4 py-3 text-sm font-semibold transition-all duration-300" data-opt="0">Sí <span class="hero-radio size-4 rounded-full border-2 border-ink-900/25 transition-all"></span></div>
              <div class="hero-opt flex items-center justify-between rounded-2xl border-2 border-ink-900/10 px-4 py-3 text-sm font-semibold transition-all duration-300" data-opt="1">No <span class="hero-radio size-4 rounded-full border-2 border-ink-900/25 transition-all"></span></div>
              <div class="hero-opt flex items-center justify-between rounded-2xl border-2 border-ink-900/10 px-4 py-3 text-sm font-semibold transition-all duration-300" data-opt="2">Me abstengo <span class="hero-radio size-4 rounded-full border-2 border-ink-900/25 transition-all"></span></div>
            </div>
            <div id="hero-submit" class="bg-brand mt-4 grid h-11 place-items-center rounded-2xl text-sm font-bold text-ink-950 transition-all duration-300">Votar</div>
          </div>
        </div>
      </div>

      <div class="hero-card absolute -bottom-20 -left-6 w-[16.5rem] rounded-3xl border border-white/10 bg-ink-800/90 p-4 shadow-2xl backdrop-blur-xl sm:-left-16">
        <div class="flex items-center justify-between">
          <p class="eyebrow text-[10px] text-white/60"><span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-turq-400 opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-turq-400"></span></span> En vivo</p>
          <p class="font-mono text-[10px] text-white/50" id="hero-units">142 / 180 unidades</p>
        </div>
        <div class="mt-3 flex h-3 overflow-hidden rounded-full bg-white/10">
          <span id="hero-bar-yes" class="h-full bg-turq-400 transition-[width] duration-700" style="width:58%"></span>
          <span id="hero-bar-no" class="h-full bg-clay-500 transition-[width] duration-700" style="width:17%"></span>
          <span id="hero-bar-abs" class="h-full bg-white/40 transition-[width] duration-700" style="width:4%"></span>
        </div>
        <div class="mt-3 grid grid-cols-3 gap-2 text-center">
          <div><p class="font-mono text-base font-bold text-turq-300" id="hero-pct-yes">58,0%</p><p class="text-[10px] text-white/50">Sí</p></div>
          <div><p class="font-mono text-base font-bold text-clay-400" id="hero-pct-no">17,0%</p><p class="text-[10px] text-white/50">No</p></div>
          <div><p class="font-mono text-base font-bold text-white/70" id="hero-pct-abs">4,0%</p><p class="text-[10px] text-white/50">Abst.</p></div>
        </div>
      </div>

      <div class="hero-chip absolute top-10 -right-4 rounded-2xl border border-turq-400/30 bg-ink-800/90 px-4 py-3 shadow-2xl backdrop-blur-xl sm:-right-10">
        <p class="text-[10px] font-semibold tracking-wider text-white/50 uppercase">Quórum</p>
        <p class="font-mono text-xl font-bold text-white"><span id="hero-quorum">71,3</span>% <span class="text-sm text-turq-400">✓</span></p>
      </div>
    </div>
  </div>

  <a href="#problema" class="hero-in absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center lg:flex" aria-label="Bajar a la siguiente sección">
    <span class="flex h-9 w-5 justify-center rounded-full border border-white/25 pt-1.5"><span class="scroll-dot size-1.5 rounded-full bg-turq-400"></span></span>
  </a>
</section>

<style>
  .hero-opt[data-active] { border-color: var(--color-turq-500); background: var(--color-turq-50); }
  .hero-opt[data-active] .hero-radio { border-width: 5px; border-color: var(--color-turq-600); }
  #hero-submit[data-done] { background: var(--color-ink-900); color: var(--color-turq-300); }
  .scroll-dot { animation: scroll-dot 1.8s ease-in-out infinite; }
  @keyframes scroll-dot { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 100% { opacity: 0; } }
</style>

<script>
  // Bucle de la maqueta: alguien elige, vota, y los resultados se mueven.
  const opts = [...document.querySelectorAll<HTMLElement>('.hero-opt')];
  const submit = document.getElementById('hero-submit')!;
  const el = (id: string) => document.getElementById(id)!;
  const fmt = (n: number) => n.toFixed(1).replace('.', ',');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let yes = 58, no = 17, abs = 4, units = 142, quorum = 71.3;
  const paint = () => {
    el('hero-bar-yes').style.width = yes + '%';
    el('hero-bar-no').style.width = no + '%';
    el('hero-bar-abs').style.width = abs + '%';
    el('hero-pct-yes').textContent = fmt(yes) + '%';
    el('hero-pct-no').textContent = fmt(no) + '%';
    el('hero-pct-abs').textContent = fmt(abs) + '%';
    el('hero-units').textContent = `${units} / 180 unidades`;
    el('hero-quorum').textContent = fmt(quorum);
  };

  let step = 0;
  const tick = () => {
    const choice = [0, 0, 1, 0, 2][step % 5];
    opts.forEach((o, i) => o.toggleAttribute('data-active', i === choice));
    setTimeout(() => {
      submit.setAttribute('data-done', '');
      submit.textContent = 'Voto registrado ✓';
      const w = 0.4 + Math.random() * 0.5;
      if (choice === 0) yes += w; else if (choice === 1) no += w; else abs += w;
      units = Math.min(180, units + 1 + Math.floor(Math.random() * 3));
      quorum = Math.min(99, quorum + 0.3 + Math.random() * 0.4);
      paint();
    }, 1100);
    setTimeout(() => {
      submit.removeAttribute('data-done');
      submit.textContent = 'Votar';
      opts.forEach((o) => o.removeAttribute('data-active'));
      if (units >= 178) { yes = 58; no = 17; abs = 4; units = 142; quorum = 71.3; paint(); }
    }, 2600);
    step++;
  };

  if (!reduce) {
    tick();
    setInterval(tick, 3200);
  } else {
    opts[0].setAttribute('data-active', '');
  }
</script>
