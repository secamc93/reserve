---
import Logo from './Logo.astro';
import { SITE, demoHref } from '../config/site';

const links = [
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#simulador', label: 'Pruébalo' },
  { href: '#precios', label: 'Precios' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

<header id="nav" class="fixed inset-x-0 top-0 z-50 px-4 pt-4 transition-transform duration-500">
  <nav
    aria-label="Principal"
    class="nav-pill mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border border-white/10 bg-ink-900/55 py-2 pr-2 pl-5 backdrop-blur-xl transition-[background-color,box-shadow] duration-300"
  >
    <a href="/" class="shrink-0"><Logo size="sm" /></a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="rounded-full px-4 py-2 text-sm font-semibold text-white/75 transition hover:bg-white/10 hover:text-white">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href={SITE.appUrl} class="hidden rounded-full px-4 py-2 text-sm font-semibold text-white/75 transition hover:text-white sm:inline-flex">Entrar</a>
      <a href={demoHref()} class="btn btn-primary !px-5 !py-3 text-sm">Pide una demo</a>
      <button
        id="nav-toggle"
        type="button"
        class="grid size-11 place-items-center rounded-full text-white hover:bg-white/10 md:hidden"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Abrir menú"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="nav-l1 origin-center transition-transform" d="M4 8h16"></path>
          <path class="nav-l2 origin-center transition-transform" d="M4 16h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-menu" hidden class="mx-auto mt-2 max-w-6xl rounded-3xl border border-white/10 bg-ink-900/95 p-3 backdrop-blur-xl md:hidden">
    <ul class="flex flex-col">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-2xl px-4 py-3 text-lg font-semibold text-white/85 hover:bg-white/10">
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a href={SITE.appUrl} class="block rounded-2xl px-4 py-3 text-lg font-semibold text-turq-300 hover:bg-white/10">Entrar al panel</a></li>
    </ul>
  </div>
</header>

<style>
  #nav[data-scrolled] .nav-pill {
    background-color: rgb(4 32 31 / 0.88);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.6);
  }
  #nav[data-hidden] { transform: translateY(-120%); }
  #nav-toggle[aria-expanded='true'] .nav-l1 { transform: translateY(4px) rotate(45deg); }
  #nav-toggle[aria-expanded='true'] .nav-l2 { transform: translateY(-4px) rotate(-45deg); }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const menu = document.getElementById('nav-menu')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.hidden = !open;
  };
  toggle.addEventListener('click', () => setOpen(menu.hidden));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Se vuelve sólida al bajar y se esconde al seguir bajando; reaparece al subir.
  let last = 0;
  addEventListener(
    'scroll',
    () => {
      const y = scrollY;
      nav.toggleAttribute('data-scrolled', y > 24);
      nav.toggleAttribute('data-hidden', y > 600 && y > last && menu.hidden);
      last = y;
    },
    { passive: true },
  );
</script>
