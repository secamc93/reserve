---

---

<section class="relative w-full h-[85vh] overflow-hidden bg-[#0A0A0A]">
  <div class="relative w-full h-full">
    <div class="carousel relative h-full overflow-hidden">
      <!-- Slides -->
      <div
        class="whitespace-nowrap transition-transform duration-700 ease-in-out animate-carousel"
      >
        <img
          src="https://images-cam93.s3.us-east-1.amazonaws.com/motos-fondo.jpg"
          alt="Moto"
          class="inline-block w-full h-[85vh] object-cover"
          style="filter: saturate(1.3) brightness(1.1) contrast(1.1);"
        />
        <img
          src="https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg"
          alt="Carro"
          class="inline-block w-full h-[85vh] object-cover"
        />
        <img
          src="https://images-cam93.s3.us-east-1.amazonaws.com/mula.jpg"
          alt="Mula"
          class="inline-block w-full h-[85vh] object-cover"
          style="filter: saturate(1.3) brightness(1.1) hue-rotate(190deg);"
        />
      </div>

      <!-- Overlay y texto -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/80 z-10 flex items-center justify-center"
      >
        <div class="text-center px-4 max-w-3xl text-white">
          <div class="flex items-center justify-center gap-3 mb-6">
            <div class="w-2 h-2 bg-[#E67E22] rounded-full"></div>
            <p class="text-sm font-bold text-[#E67E22] tracking-widest uppercase">Calidad Premium · Desde 2023</p>
            <div class="w-2 h-2 bg-[#E67E22] rounded-full"></div>
          </div>
          <h1 class="text-4xl md:text-6xl font-bold mb-4 drop-shadow-lg leading-tight">
            Lubricantes de <span class="bg-gradient-to-r from-[#E67E22] to-[#F39C12] bg-clip-text text-transparent">Alta Calidad</span>
          </h1>
          <p class="text-lg md:text-xl mb-8 drop-shadow-sm text-gray-300">
            Protege tu motor con la mejor tecnología en aceites y repuestos premium.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/productos"
              class="bg-gradient-to-r from-[#E67E22] to-[#D35400] hover:from-[#D35400] hover:to-[#B8470F] text-white px-8 py-3 rounded-lg font-semibold transition-all duration-300 inline-flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14a2 2 0 012 2v7a2 2 0 01-2 2H5a2 2 0 01-2-2v-7a2 2 0 012-2z"></path></svg>
              Ver Catálogo
            </a>
            <a
              href="/contacto"
              class="bg-white/10 hover:bg-white/20 border border-white/30 hover:border-[#E67E22]/50 text-white px-8 py-3 rounded-lg font-semibold transition-all duration-300 inline-flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              Contactanos
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes carousel {
    0%,
    20% {
      transform: translateX(0%);
    }
    25%,
    45% {
      transform: translateX(-100%);
    }
    50%,
    70% {
      transform: translateX(-100%);
    }
    75%,
    95% {
      transform: translateX(-200%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  .animate-carousel {
    animation: carousel 15s infinite;
  }
</style>
