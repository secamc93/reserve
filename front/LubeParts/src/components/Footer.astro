---
---

<footer class="bg-[#0ea5e9] border-t border-[#0284c7] mt-auto">
  <!-- Footer Top -->
  <div class="py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
        <!-- Brand Column -->
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <img
              src="/images/logo.png"
              alt="Logo LubeParts"
              class="h-12 w-auto"
            />
            <div>
              <h3 class="text-lg font-bold text-white">LubeParts</h3>
              <p class="text-xs text-white font-semibold uppercase tracking-widest">Calidad Premium</p>
            </div>
          </div>
          <p class="text-white/80 text-base leading-relaxed">
            Lubricantes de alta calidad con las mejores marcas del mercado para tu vehículo.
          </p>
        </div>

        <!-- Navigation 1 -->
        <div class="space-y-4">
          <h4 class="text-white font-bold text-base uppercase tracking-wider">Producto</h4>
          <ul class="space-y-2">
            <li>
              <a href="/productos/" class="text-white/80 hover:text-white transition-colors text-base">
                Catálogo
              </a>
            </li>
            <li>
              <a href="/productos/" class="text-white/80 hover:text-white transition-colors text-base">
                Aceites
              </a>
            </li>
          </ul>
        </div>

        <!-- Navigation 2 -->
        <div class="space-y-4">
          <h4 class="text-white font-bold text-base uppercase tracking-wider">Empresa</h4>
          <ul class="space-y-2">
            <li>
              <a href="/" class="text-white/80 hover:text-white transition-colors text-base">
                Inicio
              </a>
            </li>
            <li>
              <a href="/productos/" class="text-white/80 hover:text-white transition-colors text-base">
                Productos
              </a>
            </li>
            <li>
              <a href="/contacto/" class="text-white/80 hover:text-white transition-colors text-base">
                Contacto
              </a>
            </li>
          </ul>
        </div>

        <!-- Contact Column -->
        <div class="space-y-4">
          <h4 class="text-white font-bold text-base uppercase tracking-wider">Contacto</h4>
          <ul class="space-y-3">
            <li>
              <a href="https://wa.me/573165356255" target="_blank" rel="noopener" class="text-white/80 hover:text-white transition-colors text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.62-6.001C.122 5.281 5.403 0 12.057 0c3.187 0 6.167 1.24 8.413 3.488a11.82 11.82 0 013.491 8.414c-.003 6.654-5.284 11.935-11.938 11.935a11.9 11.9 0 01-6.003-1.617L.057 24zm6.597-3.807c1.735 1.033 3.27 1.666 5.392 1.666 5.448 0 9.886-4.434 9.889-9.877.003-5.462-4.415-9.89-9.881-9.893-5.452 0-9.886 4.434-9.889 9.885a9.86 9.86 0 001.67 5.396l-.999 3.648 3.818-.825zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.03-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.149-.173.198-.297.297-.495.099-.198.05-.372-.025-.521-.074-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.873.118.571-.085 1.758-.718 2.006-1.41.248-.695.248-1.29.173-1.41z"></path>
                </svg>
                WhatsApp
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Divider -->
  <div class="border-t border-[#0284c7]"></div>

  <!-- Footer Bottom -->
  <div class="py-6 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/80 text-sm">
        © 2025 LubeParts. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a href="#" class="text-white/80 hover:text-white transition-colors text-base">
          Privacidad
        </a>
        <a href="#" class="text-white/80 hover:text-white transition-colors text-base">
          Cookies
        </a>
      </div>
    </div>
  </div>
</footer>
