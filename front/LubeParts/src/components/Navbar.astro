---

---

<nav
  class="font-[Poppins] w-full bg-white/95 backdrop-blur-xl shadow-xl border-b border-gray-200 px-6 py-4 z-50 sticky top-0"
>
  <div class="flex items-center justify-between max-w-7xl mx-auto">
    <!-- Logo mejorado -->
    <div class="flex items-center">
      <a href="/" class="flex items-center group">
        <div class="relative">
          <img
            src="/images/logo.png"
            alt="Logo lubricantes"
            class="h-14 w-auto group-hover:scale-110 transition-all duration-500"
          />
        </div>
        <div class="ml-4">
          <span
            class="text-xl sm:text-2xl font-bold bg-gradient-to-r from-[#0284c7] to-[#0369a1] bg-clip-text text-transparent group-hover:from-[#0369a1] group-hover:to-[#0284c7] transition-all duration-500"
          >
            LubeParts
          </span>
          <p class="text-xs text-[#0284c7] font-medium -mt-1 uppercase tracking-widest">Calidad Premium</p>
        </div>
      </a>
    </div>

    <!-- Enlaces centrados con botones azul claro -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href="/"
        class="px-6 py-2.5 rounded-lg text-white bg-[#0ea5e9] hover:bg-[#0284c7] transition-all duration-300 font-semibold text-sm"
        id="nav-inicio"
      >
        Inicio
      </a>

      <a
        href="/productos/"
        class="px-6 py-2.5 rounded-lg text-white bg-[#0ea5e9] hover:bg-[#0284c7] transition-all duration-300 font-semibold text-sm"
        id="nav-productos"
      >
        Productos
      </a>

      <a
        href="/contacto/"
        class="px-6 py-2.5 rounded-lg text-white bg-[#0ea5e9] hover:bg-[#0284c7] transition-all duration-300 font-semibold text-sm"
        id="nav-contacto"
      >
        Contacto
      </a>
    </div>

    <!-- Menú hamburguesa mejorado -->
    <button
      class="md:hidden p-3 rounded-xl hover:bg-blue-50 transition-all duration-300 group"
      onclick="toggleMobileMenu()"
      aria-label="Abrir menú"
    >
      <svg
        class="w-6 h-6 text-[#0284c7] group-hover:text-[#0369a1] transition-colors duration-300"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Menú móvil mejorado -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-white/95 backdrop-blur-xl border-t border-gray-200 shadow-2xl"
  >
    <div class="px-4 py-3">
      <!-- Enlaces móviles en 3 columnas -->
      <div class="grid grid-cols-3 gap-2">
        <a
          href="/"
          class="flex flex-col items-center justify-center px-2 py-3 text-white bg-[#0ea5e9] hover:bg-[#0284c7] transition-all duration-300 font-semibold rounded-lg"
        >
          <span class="text-xs text-center">Inicio</span>
        </a>

        <a
          href="/productos/"
          class="flex flex-col items-center justify-center px-2 py-3 text-white bg-[#0ea5e9] hover:bg-[#0284c7] transition-all duration-300 font-semibold rounded-lg"
        >
          <span class="text-xs text-center">Productos</span>
        </a>

        <a
          href="/contacto/"
          class="flex flex-col items-center justify-center px-2 py-3 text-white bg-[#0ea5e9] hover:bg-[#0284c7] transition-all duration-300 font-semibold rounded-lg"
        >
          <span class="text-xs text-center">Contacto</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Función para alternar menú móvil
  function toggleMobileMenu() {
    const menu = document.getElementById("mobile-menu");
    const buttonSvg = document.querySelector(
      'button[onclick="toggleMobileMenu()"] svg'
    );

    if (!menu || !buttonSvg) return;

    if (menu.classList.contains("hidden")) {
      menu.classList.remove("hidden");
      menu.classList.add("animate-slideDown");
      // Cambiar icono a X
      buttonSvg.innerHTML =
        '<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>';
    } else {
      menu.classList.add("hidden");
      menu.classList.remove("animate-slideDown");
      // Cambiar icono a hamburguesa
      buttonSvg.innerHTML =
        '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>';
    }
  }

  // Exponer globalmente para onclick inline en producción
  // @ts-ignore
  window.toggleMobileMenu = toggleMobileMenu;

  // Indicador de página activa
  document.addEventListener("DOMContentLoaded", function () {
    const currentPath = window.location.pathname;
    const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;

    let activeLinkId = null;
    if (normalizedPath === "/") activeLinkId = "nav-inicio";
    else if (normalizedPath === "/productos/") activeLinkId = "nav-productos";
    else if (normalizedPath === "/contacto/") activeLinkId = "nav-contacto";

    if (activeLinkId) {
      const element = document.getElementById(activeLinkId);
      if (element) {
        element.classList.add("ring-2", "ring-[#6BA3D0]", "ring-offset-2");
      }
    }
  });

  // Cerrar menú móvil al hacer clic fuera
  document.addEventListener("click", function (event) {
    const menu = document.getElementById("mobile-menu");
    const button = document.querySelector(
      'button[onclick="toggleMobileMenu()"]'
    );

    const target = event.target;
    if (!(target instanceof Node)) return;

    if (
      menu &&
      button &&
      !menu.contains(target) &&
      !button.contains(target) &&
      !menu.classList.contains("hidden")
    ) {
      toggleMobileMenu();
    }
  });
</script>

<style>
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slideDown {
    animation: slideDown 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Efecto de scroll mejorado */
  nav {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  nav.scrolled {
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(20px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }

  /* Efectos de hover mejorados */
  .group:hover .group-hover\:scale-110 {
    transform: scale(1.1);
  }

  /* Gradientes animados */
  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .bg-gradient-animated {
    background-size: 200% 200%;
    animation: gradient 3s ease infinite;
  }
</style>
