---

---

<nav
  class="font-[Poppins] w-full bg-white/95 backdrop-blur-xl shadow-xl border-b border-gray-200 px-6 py-4 z-50 sticky top-0"
>
  <div class="flex items-center justify-between max-w-7xl mx-auto">
    <!-- Logo mejorado -->
    <div class="flex items-center">
      <a href="/" class="flex items-center group">
        <div class="relative">
          <img
            src="/images/logo.png"
            alt="Logo lubricantes"
            class="h-14 w-auto group-hover:scale-110 transition-all duration-500 drop-shadow-lg filter brightness-110"
          />
          <div
            class="absolute inset-0 bg-blue-500/20 rounded-full blur-xl group-hover:bg-blue-500/30 transition-all duration-500"
          >
          </div>
        </div>
        <div class="ml-4 hidden sm:block">
          <span
            class="text-2xl font-bold bg-gradient-to-r from-[#E67E22] to-[#F39C12] bg-clip-text text-transparent group-hover:from-[#F39C12] group-hover:to-[#E67E22] transition-all duration-500"
          >
            LubeParts
          </span>
          <p class="text-xs text-[#E67E22] font-medium -mt-1 uppercase tracking-widest">Calidad Premium</p>
        </div>
      </a>
    </div>

    <!-- Enlaces centrados con mejor diseño -->
    <div class="hidden md:flex items-center gap-1">
      <a
        href="/"
        class="px-6 py-3 text-gray-700 hover:text-[#E67E22] transition-all duration-300 font-semibold"
        id="nav-inicio"
      >
        Inicio
      </a>

      <a
        href="/productos/"
        class="px-6 py-3 text-gray-600 hover:text-[#E67E22] transition-all duration-300 font-semibold"
        id="nav-productos"
      >
        Productos
      </a>

      <a
        href="/contacto/"
        class="px-6 py-3 text-gray-600 hover:text-[#E67E22] transition-all duration-300 font-semibold"
        id="nav-contacto"
      >
        Contacto
      </a>
    </div>

    <!-- Menú hamburguesa mejorado -->
    <button
      class="md:hidden p-3 rounded-xl hover:bg-white/60 hover:shadow-lg transition-all duration-300 group"
      onclick="toggleMobileMenu()"
      aria-label="Abrir menú"
    >
      <div class="relative">
        <svg
          class="w-6 h-6 text-gray-700 group-hover:text-blue-600 transition-colors duration-300"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <div
          class="absolute inset-0 bg-blue-500/20 rounded-full blur-lg opacity-0 group-hover:opacity-100 transition-all duration-300"
        >
        </div>
      </div>
    </button>
  </div>

  <!-- Menú móvil mejorado -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-white/95 backdrop-blur-xl border-t border-gray-200 shadow-2xl"
  >
    <div class="px-6 py-8 space-y-6">
      <!-- Enlaces móviles con mejor diseño -->
      <div class="space-y-3">
        <a
          href="/"
          class="flex items-center px-6 py-4 text-gray-700 hover:text-[#E67E22] transition-all duration-300 font-semibold"
        >
          <span class="text-2xl mr-4">🏠</span>
          <span class="text-lg">Inicio</span>
        </a>

        <a
          href="/productos/"
          class="flex items-center px-6 py-4 text-gray-600 hover:text-[#E67E22] transition-all duration-300 font-semibold"
        >
          <span class="text-2xl mr-4">🛢️</span>
          <span class="text-lg">Productos</span>
        </a>

        <a
          href="/contacto/"
          class="flex items-center px-6 py-4 text-gray-600 hover:text-[#E67E22] transition-all duration-300 font-semibold"
        >
          <span class="text-2xl mr-4">📞</span>
          <span class="text-lg">Contacto</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Función para alternar menú móvil
  function toggleMobileMenu() {
    const menu = document.getElementById("mobile-menu");
    const buttonSvg = document.querySelector(
      'button[onclick="toggleMobileMenu()"] svg'
    );

    if (!menu || !buttonSvg) return;

    if (menu.classList.contains("hidden")) {
      menu.classList.remove("hidden");
      menu.classList.add("animate-slideDown");
      // Cambiar icono a X
      buttonSvg.innerHTML =
        '<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>';
    } else {
      menu.classList.add("hidden");
      menu.classList.remove("animate-slideDown");
      // Cambiar icono a hamburguesa
      buttonSvg.innerHTML =
        '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>';
    }
  }

  // Exponer globalmente para onclick inline en producción
  // @ts-ignore
  window.toggleMobileMenu = toggleMobileMenu;

  // Indicador de página activa
  document.addEventListener("DOMContentLoaded", function () {
    const currentPath = window.location.pathname;
    const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;

    let activeLinkId = null;
    if (normalizedPath === "/") activeLinkId = "nav-inicio";
    else if (normalizedPath === "/productos/") activeLinkId = "nav-productos";
    else if (normalizedPath === "/contacto/") activeLinkId = "nav-contacto";

    if (activeLinkId) {
      const element = document.getElementById(activeLinkId);
      if (element) {
        element.classList.add("bg-[#E67E22]", "text-white", "rounded-lg");
      }
    }
  });

  // Cerrar menú móvil al hacer clic fuera
  document.addEventListener("click", function (event) {
    const menu = document.getElementById("mobile-menu");
    const button = document.querySelector(
      'button[onclick="toggleMobileMenu()"]'
    );

    const target = event.target;
    if (!(target instanceof Node)) return;

    if (
      menu &&
      button &&
      !menu.contains(target) &&
      !button.contains(target) &&
      !menu.classList.contains("hidden")
    ) {
      toggleMobileMenu();
    }
  });
</script>

<style>
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slideDown {
    animation: slideDown 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Efecto de scroll mejorado */
  nav {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  nav.scrolled {
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(20px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }

  /* Efectos de hover mejorados */
  .group:hover .group-hover\:scale-110 {
    transform: scale(1.1);
  }

  /* Gradientes animados */
  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .bg-gradient-animated {
    background-size: 200% 200%;
    animation: gradient 3s ease infinite;
  }
</style>
