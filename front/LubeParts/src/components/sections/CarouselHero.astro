---
// Componente Carrusel Hero con navegación automática
---

<section class="relative w-full h-[90vh] overflow-hidden">
  <div class="relative w-full h-full">
    <div class="carousel relative h-full overflow-hidden">
      <!-- Slides Container -->
      <div
        id="carousel-track"
        class="carousel-track flex"
        style="width: 100%; transform: translateX(0%); transition: transform 0.8s ease-in-out;"
      >
        <img
          src="https://wallpapers.com/images/hd/2560x1440-motorcycle-jj0dzt12hgthegta.jpg"
          alt="Moto"
          class="w-full h-[90vh] object-cover flex-shrink-0"
          style="filter: saturate(1.3) brightness(1.1) contrast(1.1); object-position: center bottom;"
        />
        <img
          src="https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg"
          alt="Carro"
          class="w-full h-[90vh] object-cover flex-shrink-0"
        />
        <img
          src="https://www.wradio.com.co/resizer/v2/UG5IGH23ORCWDGNIB6YBZZI6TA.jpg?auth=90078340bd7be0dcff0cbcd64427e3c12f6526387513173633054cc0fc64945f"
          alt="Vehículo"
          class="w-full h-[90vh] object-cover flex-shrink-0"
        />
      </div>

      <!-- Overlay y contenido -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-black/70 z-10 flex items-center"
      >
        <div class="container mx-auto px-6">
          <div class="max-w-4xl">
            <div class="animate-fadeInUp">
              <h1
                class="text-5xl md:text-7xl font-bold mb-6 text-white drop-shadow-2xl leading-tight"
              >
                LUBRICANTES DE
                <span
                  class="bg-gradient-to-r from-orange-400 to-orange-600 bg-clip-text text-transparent"
                >
                  ALTA CALIDAD
                </span>
              </h1>
              <p
                class="text-xl md:text-2xl mb-8 text-gray-100 drop-shadow-lg leading-relaxed font-semibold"
              >
                Todas las marcas líderes en un solo lugar, El respaldo que tu negocio y/o empresa necesita.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="/productos/"
                  class="bg-gradient-to-r from-[#E67E22] to-[#D35400] hover:from-[#D35400] hover:to-[#B8470F] text-white px-12 py-4 rounded-xl font-bold text-lg transition-all duration-300 transform hover:scale-105 shadow-2xl hover:shadow-[#E67E22]/50 inline-flex items-center justify-center gap-3 w-full sm:w-auto"
                >
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14a2 2 0 012 2v7a2 2 0 01-2 2H5a2 2 0 01-2-2v-7a2 2 0 012-2z"></path>
                  </svg>
                  Ver Catálogo
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Indicadores de carrusel -->
      <div
        class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 flex space-x-3"
      >
        <div id="carousel-indicator-0" class="w-3 h-3 bg-white/80 rounded-full transition-all duration-300"></div>
        <div id="carousel-indicator-1" class="w-3 h-3 bg-white/30 rounded-full transition-all duration-300"></div>
        <div id="carousel-indicator-2" class="w-3 h-3 bg-white/30 rounded-full transition-all duration-300"></div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeInUp {
    animation: fadeInUp 1s ease-out;
  }

  .carousel-track {
    will-change: transform;
  }
</style>

<script>
  let currentSlide = 0;
  const totalSlides = 3;
  const slideInterval = 5000;

  const carouselTrack = document.getElementById('carousel-track');
  const indicator0 = document.getElementById('carousel-indicator-0');
  const indicator1 = document.getElementById('carousel-indicator-1');
  const indicator2 = document.getElementById('carousel-indicator-2');

  function updateCarousel() {
    if (!carouselTrack) return;

    const offset = currentSlide * -100;
    carouselTrack.style.transform = `translateX(${offset}%)`;

    // Update all indicators
    const indicators = [indicator0, indicator1, indicator2];
    indicators.forEach((ind, i) => {
      if (ind) {
        if (i === currentSlide) {
          ind.classList.add('bg-white/80');
          ind.classList.remove('bg-white/30');
        } else {
          ind.classList.remove('bg-white/80');
          ind.classList.add('bg-white/30');
        }
      }
    });
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateCarousel();
  }

  setInterval(nextSlide, slideInterval);
</script>
