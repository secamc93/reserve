---
import BaseLayout from "../layouts/BaseLayout.astro";
import CarouselHero from "../components/ui/CarouselHero.astro";
import "../styles/sections.css";
---

<BaseLayout title="Lubricantes Premium - Calidad y Confianza">
  <!-- Carrusel Hero -->
  <CarouselHero />

  <!-- Sección de Características Destacadas -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-sm font-bold text-[var(--color-primary-orange)] tracking-widest mb-4 uppercase">¿Por qué elegirnos?</p>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          La diferencia está en la calidad
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Porque unimos el catálogo de marcas más completo del mercado con una logística inmediata diseñada para que tu negocio y empresa nunca se detenga.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Característica 1 -->
        <div
          class="bg-gray-50 rounded-2xl p-8 hover:shadow-2xl transition-all duration-500 border border-gray-200 hover:border-[#E67E22]/30"
        >
          <div
            class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 mx-auto text-4xl bg-[#E67E22]"
          >
            📦
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">
            Catálogo
          </h3>
          <p class="text-gray-600 text-center leading-relaxed">
            Todas las marcas líderes en un solo lugar. Optimiza tu gestión de compras y ofrece a tus clientes la exclusividad de las marcas líderes a nivel mundial.
          </p>
        </div>

        <!-- Característica 2 -->
        <div
          class="bg-gray-50 rounded-2xl p-8 hover:shadow-2xl transition-all duration-500 border border-gray-200 hover:border-[#0ea5e9]/30"
        >
          <div
            class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 mx-auto text-4xl bg-[#0ea5e9]"
          >
            ⚡
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">
            Servicio Especializado
          </h3>
          <p class="text-gray-600 text-center leading-relaxed">
            No solo entregamos productos, brindamos asesoría técnica y comercial para optimizar la rotación de tu inventario.
          </p>
        </div>

        <!-- Característica 3 -->
        <div
          class="bg-gray-50 rounded-2xl p-8 hover:shadow-2xl transition-all duration-500 border border-gray-200 hover:border-[#E67E22]/30"
        >
          <div
            class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 mx-auto text-4xl bg-[#E67E22]"
          >
            🏆
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">
            Calidad de origen
          </h3>
          <p class="text-gray-600 text-center leading-relaxed">
            Garantizamos productos 100% originales con trazabilidad directa de fábrica.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de Marcas Destacadas -->
  <section class="py-20" style="background-color: var(--color-primary-orange);">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Marcas Destacadas
        </h2>
        <p class="text-xl text-white/90 max-w-3xl mx-auto">
          Las marcas líderes en la industria confían en nosotros
        </p>
      </div>

      <div class="relative overflow-hidden">
        <div class="brands-carousel">
          <div class="brands-track animate-brand-scroll">
            <!-- Brand 1: Ipone -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://cdn.freebiesupply.com/logos/large/2x/ipone-logo-png-transparent.png" alt="Ipone" class="brand-logo" />
              </div>
              <p class="brand-name">Ipone</p>
            </div>

            <!-- Brand 2: Liqui Moly -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://liqui-moly.com.co/wp-content/uploads/2022/03/LOGO-ACTUAL-2025.png" alt="Liqui Moly" class="brand-logo" />
              </div>
              <p class="brand-name">Liqui Moly</p>
            </div>

            <!-- Brand 3: Motul -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://1000logos.net/wp-content/uploads/2020/04/Logo-Motul.png" alt="Motul" class="brand-logo" />
              </div>
              <p class="brand-name">Motul</p>
            </div>

            <!-- Brand 4: Mobil -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/3/3d/Mobil_logo.svg/1280px-Mobil_logo.svg.png" alt="Mobil" class="brand-logo" />
              </div>
              <p class="brand-name">Mobil</p>
            </div>

            <!-- Brand 5: Shell -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://upload.wikimedia.org/wikipedia/en/thumb/e/e8/Shell_logo.svg/1280px-Shell_logo.svg.png" alt="Shell" class="brand-logo" />
              </div>
              <p class="brand-name">Shell</p>
            </div>

            <!-- Brand 6: Castrol -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://crystalpng.com/wp-content/uploads/2025/03/castrol-logo.png" alt="Castrol" class="brand-logo" />
              </div>
              <p class="brand-name">Castrol</p>
            </div>

            <!-- Brand 7: Motorex -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://lezebre.lu/images/detailed/15/18971-motorex-oil-logo.png" alt="Motorex" class="brand-logo" />
              </div>
              <p class="brand-name">Motorex</p>
            </div>

            <!-- Brand 8: Eni -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://download.logo.wine/logo/Eni/Eni-Logo.wine.png" alt="Eni" class="brand-logo" />
              </div>
              <p class="brand-name">Eni</p>
            </div>

            <!-- Brand 9: Ecstar -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://cdn.shopify.com/s/files/1/0733/5752/5215/files/ecstar-suzuki.svg?v=1736021458" alt="Ecstar" class="brand-logo" />
              </div>
              <p class="brand-name">Ecstar</p>
            </div>

            <!-- Brand 10: Bajaj -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2b/Bajaj_Auto_Ltd_logo.svg/1280px-Bajaj_Auto_Ltd_logo.svg.png" alt="Bajaj" class="brand-logo" />
              </div>
              <p class="brand-name">Bajaj</p>
            </div>

            <!-- Brand 11: Yamalube -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://images.seeklogo.com/logo-png/17/2/yamalube-logo-png_seeklogo-173930.png" alt="Yamalube" class="brand-logo" />
              </div>
              <p class="brand-name">Yamalube</p>
            </div>

            <!-- Brand 12: Repsol -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e8/Repsol_logo.svg/1280px-Repsol_logo.svg.png" alt="Repsol" class="brand-logo" />
              </div>
              <p class="brand-name">Repsol</p>
            </div>

            <!-- Brand 13: Elf -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://elf.co/themes/custom/butterfly_theme/elf-logo.svg?v=1.1" alt="Elf" class="brand-logo" />
              </div>
              <p class="brand-name">Elf</p>
            </div>

            <!-- Duplicate all brands for infinite loop -->
            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://cdn.freebiesupply.com/logos/large/2x/ipone-logo-png-transparent.png" alt="Ipone" class="brand-logo" />
              </div>
              <p class="brand-name">Ipone</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://liqui-moly.com.co/wp-content/uploads/2022/03/LOGO-ACTUAL-2025.png" alt="Liqui Moly" class="brand-logo" />
              </div>
              <p class="brand-name">Liqui Moly</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://1000logos.net/wp-content/uploads/2020/04/Logo-Motul.png" alt="Motul" class="brand-logo" />
              </div>
              <p class="brand-name">Motul</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/3/3d/Mobil_logo.svg/1280px-Mobil_logo.svg.png" alt="Mobil" class="brand-logo" />
              </div>
              <p class="brand-name">Mobil</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://upload.wikimedia.org/wikipedia/en/thumb/e/e8/Shell_logo.svg/1280px-Shell_logo.svg.png" alt="Shell" class="brand-logo" />
              </div>
              <p class="brand-name">Shell</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://crystalpng.com/wp-content/uploads/2025/03/castrol-logo.png" alt="Castrol" class="brand-logo" />
              </div>
              <p class="brand-name">Castrol</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://lezebre.lu/images/detailed/15/18971-motorex-oil-logo.png" alt="Motorex" class="brand-logo" />
              </div>
              <p class="brand-name">Motorex</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://download.logo.wine/logo/Eni/Eni-Logo.wine.png" alt="Eni" class="brand-logo" />
              </div>
              <p class="brand-name">Eni</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://cdn.shopify.com/s/files/1/0733/5752/5215/files/ecstar-suzuki.svg?v=1736021458" alt="Ecstar" class="brand-logo" />
              </div>
              <p class="brand-name">Ecstar</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2b/Bajaj_Auto_Ltd_logo.svg/1280px-Bajaj_Auto_Ltd_logo.svg.png" alt="Bajaj" class="brand-logo" />
              </div>
              <p class="brand-name">Bajaj</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://images.seeklogo.com/logo-png/17/2/yamalube-logo-png_seeklogo-173930.png" alt="Yamalube" class="brand-logo" />
              </div>
              <p class="brand-name">Yamalube</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e8/Repsol_logo.svg/1280px-Repsol_logo.svg.png" alt="Repsol" class="brand-logo" />
              </div>
              <p class="brand-name">Repsol</p>
            </div>

            <div class="brand-item">
              <div class="brand-logo-container">
                <img src="https://elf.co/themes/custom/butterfly_theme/elf-logo.svg?v=1.1" alt="Elf" class="brand-logo" />
              </div>
              <p class="brand-name">Elf</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- Sección de Contacto -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="text-gray-900">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            <p class="text-sm font-bold tracking-widest uppercase" style="color: var(--color-primary-orange);">Información de Contacto</p>
          </div>
          <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900">
            CONTACTANOS
          </h2>
          <p class="text-lg text-gray-600 mb-8 leading-relaxed">
            Nuestro equipo está listo para asesorarte.
          </p>
          <div class="space-y-4">
            <div class="flex items-center">
              <div
                class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mr-4"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-6 h-6 text-white"
                >
                  <path
                    d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.62-6.001C.122 5.281 5.403 0 12.057 0c3.187 0 6.167 1.24 8.413 3.488a11.82 11.82 0 013.491 8.414c-.003 6.654-5.284 11.935-11.938 11.935a11.9 11.9 0 01-6.003-1.617L.057 24zm6.597-3.807c1.735 1.033 3.27 1.666 5.392 1.666 5.448 0 9.886-4.434 9.889-9.877.003-5.462-4.415-9.89-9.881-9.893-5.452 0-9.886 4.434-9.889 9.885a9.86 9.86 0 001.67 5.396l-.999 3.648 3.818-.825zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.03-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.149-.173.198-.297.297-.495.099-.198.05-.372-.025-.521-.074-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.873.118.571-.085 1.758-.718 2.006-1.41.248-.695.248-1.29.173-1.41z"
                  ></path>
                </svg>
              </div>
              <div>
                <div class="font-semibold">WhatsApp</div>
                <a href="https://wa.me/573165356255" target="_blank" rel="noopener" class="text-gray-300 hover:text-green-400">
                  +57 316 5356255
                </a>
              </div>
            </div>
            <div class="flex items-center">
              <div
                class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mr-4"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <div class="font-semibold">Email</div>
                <div class="text-gray-300">lubeparts@gmail.com</div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8 shadow-2xl border border-gray-200">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">
            Envíanos un mensaje
          </h3>
          <form id="mini-contact-form" class="space-y-4">
            <div>
              <input
                id="mini-name"
                type="text"
                placeholder="Tu nombre"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-500 focus:ring-2 focus:ring-[var(--color-primary-orange)] focus:border-transparent"
              />
            </div>
            <div>
              <input
                id="mini-email"
                type="email"
                placeholder="Tu email"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-500 focus:ring-2 focus:ring-[var(--color-primary-orange)] focus:border-transparent"
              />
            </div>
            <div>
              <textarea
                id="mini-message"
                placeholder="Tu mensaje"
                rows="4"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-500 focus:ring-2 focus:ring-[var(--color-primary-orange)] focus:border-transparent"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-[var(--color-primary-orange)] to-[var(--color-primary-orange-dark)] hover:from-[var(--color-primary-orange-dark)] hover:to-[var(--color-primary-orange-darker)] text-white py-3 rounded-lg font-bold transition-all duration-300 transform hover:scale-105"
            >
              Enviar Mensaje
            </button>
          </form>
          <!-- Panel WhatsApp -->
          <div
            id="mini-wa-panel"
            class="fixed inset-0 bg-black/50 backdrop-blur-sm items-center justify-center hidden z-50"
          >
            <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-2xl border border-gray-200">
              <h4 class="text-xl font-bold text-gray-900 mb-2">
                Enviar por WhatsApp
              </h4>
              <p class="text-gray-600 mb-4">
                Abriremos WhatsApp con tu mensaje prellenado. Revisa y presiona
                enviar.
              </p>
              <div class="flex gap-3">
                <a
                  id="mini-wa-link"
                  target="_blank"
                  rel="noopener"
                  href="#"
                  class="flex-1 inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-3 rounded-xl font-semibold transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-5 h-5"
                    ><path
                      d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.62-6.001C.122 5.281 5.403 0 12.057 0c3.187 0 6.167 1.24 8.413 3.488a11.82 11.82 0 013.491 8.414c-.003 6.654-5.284 11.935-11.938 11.935a11.9 11.9 0 01-6.003-1.617L.057 24zm6.597-3.807c1.735 1.033 3.27 1.666 5.392 1.666 5.448 0 9.886-4.434 9.889-9.877.003-5.462-4.415-9.89-9.881-9.893-5.452 0-9.886 4.434-9.889 9.885a9.86 9.86 0 001.67 5.396l-.999 3.648 3.818-.825zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.03-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.149-.173.198-.297.297-.495.099-.198.05-.372-.025-.521-.074-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.873.118.571-.085 1.758-.718 2.006-1.41.248-.695.248-1.29.173-1.41z"
                    ></path></svg
                  >
                  Abrir WhatsApp
                </a>
                <button
                  id="mini-wa-close"
                  class="px-4 py-3 rounded-xl border border-gray-300 text-gray-600 bg-gray-50 hover:bg-gray-100"
                  >Cancelar</button
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>


<script>
  const whatsappPhone = "573165356255";
  const miniForm = document.getElementById("mini-contact-form");
  const miniPanel = document.getElementById("mini-wa-panel");
  const miniWaLink = document.getElementById("mini-wa-link");
  const miniWaClose = document.getElementById("mini-wa-close");

  function miniOpenPanel() {
    if (!miniPanel) return;
    miniPanel.classList.remove("hidden");
    miniPanel.classList.add("flex");
  }
  function miniClosePanel() {
    if (!miniPanel) return;
    miniPanel.classList.add("hidden");
    miniPanel.classList.remove("flex");
  }
  if (miniWaClose) {
    miniWaClose.addEventListener("click", (e) => {
      e.preventDefault();
      miniClosePanel();
    });
  }

  if (miniForm) {
    miniForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const nameEl = document.querySelector('#mini-name');
      const emailEl = document.querySelector('#mini-email');
      const messageEl = document.querySelector('#mini-message');
      const name = nameEl && 'value' in nameEl ? String(nameEl.value).trim() : "";
      const email = emailEl && 'value' in emailEl ? String(emailEl.value).trim() : "";
      const message = messageEl && 'value' in messageEl ? String(messageEl.value).trim() : "";
      const text = `Hola, soy ${name} (${email}).\nMensaje: ${message}`;
      const url = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(text)}`;
      if (miniWaLink) miniWaLink.setAttribute("href", url);
      miniOpenPanel();
    });
  }
</script>
