---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProductCard from "../components/ProductCard.astro";

// Productos destacados para mostrar en la página principal
const featuredProducts = [
  {
    id: "aceite-motor-1",
    name: "Aceite de Motor Premium",
    price: 45.99,
    image: "https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg",
    viscosity: "SAE 5W-30",
    description: "Aceite de motor de alta calidad para vehículos modernos",
  },
  {
    id: "aceite-motor-2",
    name: "Aceite Sintético Avanzado",
    price: 52.99,
    image: "https://images-cam93.s3.us-east-1.amazonaws.com/motos-fondo.jpg",
    viscosity: "SAE 10W-40",
    description:
      "Aceite sintético de última generación para máximo rendimiento",
  },
  {
    id: "aceite-motor-3",
    name: "Aceite para Motos Deportivas",
    price: 38.99,
    image: "https://images-cam93.s3.us-east-1.amazonaws.com/mula.jpg",
    viscosity: "SAE 15W-50",
    description:
      "Especialmente formulado para motocicletas de alto rendimiento",
  },
];
---

<BaseLayout title="Lubricantes Premium - Calidad y Confianza">
  <!-- Hero Section Mejorado -->
  <section class="relative w-full h-[90vh] overflow-hidden">
    <div class="relative w-full h-full">
      <div class="carousel relative h-full overflow-hidden">
        <!-- Slides -->
        <div
          class="whitespace-nowrap transition-transform duration-700 ease-in-out animate-carousel"
          style="width: 300%;"
        >
          <img
            src="https://images-cam93.s3.us-east-1.amazonaws.com/motos-fondo.jpg"
            alt="Moto"
            class="inline-block w-1/3 h-[90vh] object-cover"
            style="filter: saturate(1.3) brightness(1.1) contrast(1.1);"
          />
          <img
            src="https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg"
            alt="Carro"
            class="inline-block w-1/3 h-[90vh] object-cover"
          />
          <img
            src="https://images-cam93.s3.us-east-1.amazonaws.com/mula.jpg"
            alt="Mula"
            class="inline-block w-1/3 h-[90vh] object-cover"
            style="filter: saturate(1.3) brightness(1.1) hue-rotate(190deg);"
          />
        </div>

        <!-- Overlay y contenido mejorado -->
        <div
          class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-black/70 z-10 flex items-center"
        >
          <div class="container mx-auto px-6">
            <div class="max-w-4xl">
              <div class="animate-fadeInUp">
                <h1
                  class="text-5xl md:text-7xl font-bold mb-6 text-white drop-shadow-2xl leading-tight"
                >
                  LUBRICANTES DE
                  <span
                    class="bg-gradient-to-r from-orange-400 to-orange-600 bg-clip-text text-transparent"
                  >
                    ALTA CALIDAD
                  </span>
                </h1>
                <p
                  class="text-xl md:text-2xl mb-8 text-gray-100 drop-shadow-lg leading-relaxed font-semibold"
                >
                  Todas las marcas líderes en un solo lugar, El respaldo que tu negocio y/o empresa necesita.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                  <a
                    href="/productos/"
                    class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-8 py-4 rounded-xl font-bold text-lg transition-all duration-300 transform hover:scale-105 shadow-2xl hover:shadow-blue-500/25"
                  >
                    🛢️ Ver Productos
                  </a>
                  <a
                    href="/nosotros/"
                    class="bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg transition-all duration-300 border-2 border-white/30 hover:border-white/50"
                  >
                    👥 Conócenos
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Indicadores de carrusel -->
        <div
          class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 flex space-x-3"
        >
          <div class="w-3 h-3 bg-white/50 rounded-full animate-pulse"></div>
          <div class="w-3 h-3 bg-white/30 rounded-full"></div>
          <div class="w-3 h-3 bg-white/30 rounded-full"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de Características Destacadas -->
  <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
          ¿Por qué elegirnos?
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Porque unimos el catálogo de marcas más completo del mercado con una logística inmediata diseñada para que tu negocio y empresa nunca se detenga.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Característica 1 -->
        <div
          class="bg-white rounded-2xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 border border-gray-100"
        >
          <div
            class="w-16 h-16 bg-gradient-to-r from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center mb-6 mx-auto"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-800 mb-4 text-center">
            Catálogo
          </h3>
          <p class="text-gray-600 text-center leading-relaxed">
            Todas las marcas líderes en un solo lugar. Optimiza tu gestión de compras y ofrece a tus clientes la exclusividad de las marcas líderes a nivel mundial.
          </p>
        </div>

        <!-- Característica 2 -->
        <div
          class="bg-white rounded-2xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 border border-gray-100"
        >
          <div
            class="w-16 h-16 bg-gradient-to-r from-green-500 to-green-600 rounded-2xl flex items-center justify-center mb-6 mx-auto"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-800 mb-4 text-center">
            Servicio Especializado
          </h3>
          <p class="text-gray-600 text-center leading-relaxed">
            No solo entregamos productos, brindamos asesoría técnica y comercial para optimizar la rotación de tu inventario.
          </p>
        </div>

        <!-- Característica 3 -->
        <div
          class="bg-white rounded-2xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 border border-gray-100"
        >
          <div
            class="w-16 h-16 bg-gradient-to-r from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mb-6 mx-auto"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 009.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-800 mb-4 text-center">
            Calidad de origen
          </h3>
          <p class="text-gray-600 text-center leading-relaxed">
            Garantizamos productos 100% originales con trazabilidad directa de fábrica.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de Productos Destacados -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
          Productos Destacados
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Descubre nuestra selección de lubricantes premium más populares
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        {
          featuredProducts.map((product) => (
            <ProductCard
              id={product.id}
              name={product.name}
              price={product.price}
              image={product.image}
              viscosity={product.viscosity}
              description={product.description}
            />
          ))
        }
      </div>

      <div class="text-center">
        <a
          href="/productos/"
          class="inline-flex items-center bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-8 py-4 rounded-xl font-bold text-lg transition-all duration-300 transform hover:scale-105 shadow-xl"
        >
          Ver Todos los Productos
          <svg
            class="w-5 h-5 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Sección de Estadísticas -->
  <section class="py-20 bg-gradient-to-r from-blue-600 to-blue-800">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-4 gap-8 text-center">
        <div class="text-white">
          <div class="text-4xl md:text-5xl font-bold mb-2 animate-count">
            2+
          </div>
          <div class="text-blue-100 text-lg">Años de Experiencia</div>
        </div>
        <div class="text-white">
          <div class="text-4xl md:text-5xl font-bold mb-2 animate-count">
            145+
          </div>
          <div class="text-blue-100 text-lg">Clientes Satisfechos</div>
        </div>
        <div class="text-white">
          <div class="text-4xl md:text-5xl font-bold mb-2 animate-count">
            50+
          </div>
          <div class="text-blue-100 text-lg">Productos Premium</div>
        </div>
        <div class="text-white">
          <div class="text-4xl md:text-5xl font-bold mb-2 animate-count">
            99%
          </div>
          <div class="text-blue-100 text-lg">Satisfacción</div>
        </div>
      </div>
    </div>
  </section>


  <!-- Sección de Contacto -->
  <section class="py-20 bg-gradient-to-r from-gray-800 to-gray-900">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="text-white">
          <h2 class="text-4xl md:text-5xl font-bold mb-6">
            CONTACTANOS
          </h2>
          <p class="text-xl text-gray-300 mb-8 leading-relaxed">
            Nuestro equipo está listo para asesorarte.
          </p>
          <div class="space-y-4">
            <div class="flex items-center">
              <div
                class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mr-4"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-6 h-6 text-white"
                >
                  <path
                    d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.62-6.001C.122 5.281 5.403 0 12.057 0c3.187 0 6.167 1.24 8.413 3.488a11.82 11.82 0 013.491 8.414c-.003 6.654-5.284 11.935-11.938 11.935a11.9 11.9 0 01-6.003-1.617L.057 24zm6.597-3.807c1.735 1.033 3.27 1.666 5.392 1.666 5.448 0 9.886-4.434 9.889-9.877.003-5.462-4.415-9.89-9.881-9.893-5.452 0-9.886 4.434-9.889 9.885a9.86 9.86 0 001.67 5.396l-.999 3.648 3.818-.825zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.03-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.149-.173.198-.297.297-.495.099-.198.05-.372-.025-.521-.074-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.873.118.571-.085 1.758-.718 2.006-1.41.248-.695.248-1.29.173-1.41z"
                  ></path>
                </svg>
              </div>
              <div>
                <div class="font-semibold">WhatsApp</div>
                <a href="https://wa.me/573165356255" target="_blank" rel="noopener" class="text-gray-300 hover:text-green-400">
                  +57 316 5356255
                </a>
              </div>
            </div>
            <div class="flex items-center">
              <div
                class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mr-4"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <div class="font-semibold">Email</div>
                <div class="text-gray-300">lubeparts@gmail.com</div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-2xl">
          <h3 class="text-2xl font-bold text-gray-800 mb-6">
            Envíanos un mensaje
          </h3>
          <form id="mini-contact-form" class="space-y-4">
            <div>
              <input
                id="mini-name"
                type="text"
                placeholder="Tu nombre"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>
            <div>
              <input
                id="mini-email"
                type="email"
                placeholder="Tu email"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>
            <div>
              <textarea
                id="mini-message"
                placeholder="Tu mensaje"
                rows="4"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white py-3 rounded-lg font-bold transition-all duration-300 transform hover:scale-105"
            >
              Enviar Mensaje
            </button>
          </form>
          <!-- Panel WhatsApp -->
          <div
            id="mini-wa-panel"
            class="fixed inset-0 bg-black/50 backdrop-blur-sm items-center justify-center hidden z-50"
          >
            <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-2xl">
              <h4 class="text-xl font-bold text-gray-800 mb-2">
                Enviar por WhatsApp
              </h4>
              <p class="text-gray-600 mb-4">
                Abriremos WhatsApp con tu mensaje prellenado. Revisa y presiona
                enviar.
              </p>
              <div class="flex gap-3">
                <a
                  id="mini-wa-link"
                  target="_blank"
                  rel="noopener"
                  href="#"
                  class="flex-1 inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-3 rounded-xl font-semibold transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-5 h-5"
                    ><path
                      d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.62-6.001C.122 5.281 5.403 0 12.057 0c3.187 0 6.167 1.24 8.413 3.488a11.82 11.82 0 013.491 8.414c-.003 6.654-5.284 11.935-11.938 11.935a11.9 11.9 0 01-6.003-1.617L.057 24zm6.597-3.807c1.735 1.033 3.27 1.666 5.392 1.666 5.448 0 9.886-4.434 9.889-9.877.003-5.462-4.415-9.89-9.881-9.893-5.452 0-9.886 4.434-9.889 9.885a9.86 9.86 0 001.67 5.396l-.999 3.648 3.818-.825zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.03-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.149-.173.198-.297.297-.495.099-.198.05-.372-.025-.521-.074-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.873.118.571-.085 1.758-.718 2.006-1.41.248-.695.248-1.29.173-1.41z"
                    ></path></svg
                  >
                  Abrir WhatsApp
                </a>
                <button
                  id="mini-wa-close"
                  class="px-4 py-3 rounded-xl border border-gray-300 text-gray-700 hover:bg-gray-50"
                  >Cancelar</button
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes carousel {
    0%,
    25% {
      transform: translateX(0%);
    }
    33.33%,
    58.33% {
      transform: translateX(-33.33%);
    }
    66.66%,
    91.66% {
      transform: translateX(-66.66%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  .animate-carousel {
    animation: carousel 15s infinite ease-in-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeInUp {
    animation: fadeInUp 1s ease-out;
  }

  @keyframes count {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-count {
    animation: count 1s ease-out;
  }
</style>

<script>
  const whatsappPhone = "573165356255";
  const miniForm = document.getElementById("mini-contact-form");
  const miniPanel = document.getElementById("mini-wa-panel");
  const miniWaLink = document.getElementById("mini-wa-link");
  const miniWaClose = document.getElementById("mini-wa-close");

  function miniOpenPanel() {
    if (!miniPanel) return;
    miniPanel.classList.remove("hidden");
    miniPanel.classList.add("flex");
  }
  function miniClosePanel() {
    if (!miniPanel) return;
    miniPanel.classList.add("hidden");
    miniPanel.classList.remove("flex");
  }
  if (miniWaClose) {
    miniWaClose.addEventListener("click", (e) => {
      e.preventDefault();
      miniClosePanel();
    });
  }

  if (miniForm) {
    miniForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const nameEl = document.querySelector('#mini-name');
      const emailEl = document.querySelector('#mini-email');
      const messageEl = document.querySelector('#mini-message');
      const name = nameEl && 'value' in nameEl ? String(nameEl.value).trim() : "";
      const email = emailEl && 'value' in emailEl ? String(emailEl.value).trim() : "";
      const message = messageEl && 'value' in messageEl ? String(messageEl.value).trim() : "";
      const text = `Hola, soy ${name} (${email}).\nMensaje: ${message}`;
      const url = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(text)}`;
      if (miniWaLink) miniWaLink.setAttribute("href", url);
      miniOpenPanel();
    });
  }
</script>
