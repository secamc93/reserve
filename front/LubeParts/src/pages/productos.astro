    { id: "castrol-gtx-20w50", name: "Castrol GTX 20W-50", price: 34.99, image: "https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg", description: "Aceite Castrol GTX para carros", viscosity: "20W-50", category: "livianos", brand: "Castrol" },
    { id: "castrol-gtx-ultraclean-10w40", name: "Castrol GTX Ultraclean 10W-40", price: 37.99, image: "https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg", description: "Aceite Castrol GTX Ultraclean para carros", viscosity: "10W-40", category: "livianos", brand: "Castrol" },

    // VEHÍCULOS LIVIANOS - ELF
    { id: "elf-evolution-900-sxr-5w40", name: "Evolution 900 SXR 5W-40", price: 41.99, image: "https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg", description: "Aceite Elf Evolution 900 SXR para carros", viscosity: "5W-40", category: "livianos", brand: "ELF" },
    { id: "elf-evolution-700-sti-10w40", name: "Evolution 700 STI 10W-40", price: 36.99, image: "https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg", description: "Aceite Elf Evolution 700 STI para carros", viscosity: "10W-40", category: "livianos", brand: "ELF" },
    { id: "elf-solaris-ec-5w30", name: "Solaris EC 5W-30", price: 39.99, image: "https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg", description: "Aceite Elf Solaris EC para carros económicos", viscosity: "5W-30", category: "livianos", brand: "ELF" },
    { id: "elf-competition-sti-10w60", name: "Competition STI 10W-60", price: 49.99, image: "https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg", description: "Aceite Elf Competition para carros de competencia", viscosity: "10W-60", category: "livianos", brand: "ELF" },

    // VEHÍCULOS PESADOS - MOBIL
    { id: "mobil-delvac-1-5w40", name: "Mobil Delvac 1 5W-40", price: 58.99, image: "https://images.unsplash.com/photo-1766561993769-b834c1c6e456?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080", description: "Aceite Mobil Delvac para camiones", viscosity: "5W-40", category: "pesados", brand: "Mobil" },
    { id: "mobil-delvac-mx-extra-10w40", name: "Mobil Delvac MX Extra 10W-40", price: 54.99, image: "https://images.unsplash.com/photo-1766561993769-b834c1c6e456?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080", description: "Aceite Mobil Delvac MX Extra para vehículos pesados", viscosity: "10W-40", category: "pesados", brand: "Mobil" },
    { id: "mobil-delvac-mx-15w40", name: "Mobil Delvac MX 15W-40", price: 52.99, image: "https://images.unsplash.com/photo-1766561993769-b834c1c6e456?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080", description: "Aceite Mobil Delvac MX para camiones", viscosity: "15W-40", category: "pesados", brand: "Mobil" },
    { id: "mobil-delvac-1300-super-15w40", name: "Mobil Delvac 1300 Super 15W-40", price: 56.99, image: "https://images.unsplash.com/photo-1766561993769-b834c1c6e456?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080", description: "Aceite Mobil Delvac 1300 Super para vehículos pesados", viscosity: "15W-40", category: "pesados", brand: "Mobil" },

    // VEHÍCULOS PESADOS - CASTROL
    { id: "castrol-rx-super-15w40", name: "Castrol RX Super 15W-40", price: 55.99, image: "https://images.unsplash.com/photo-1766561993769-b834c1c6e456?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080", description: "Aceite Castrol RX Super para camiones", viscosity: "15W-40", category: "pesados", brand: "Castrol" },
    { id: "castrol-vecton-15w40", name: "Castrol Vecton 15W-40", price: 57.99, image: "https://images.unsplash.com/photo-1766561993769-b834c1c6e456?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080", description: "Aceite Castrol Vecton para vehículos pesados", viscosity: "15W-40", category: "pesados", brand: "Castrol" },
    { id: "castrol-crb-multi-20w50", name: "Castrol CRB Multi 20W-50", price: 53.99, image: "https://images.unsplash.com/photo-1766561993769-b834c1c6e456?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080", description: "Aceite Castrol CRB Multi para camiones", viscosity: "20W-50", category: "pesados", brand: "Castrol" },
    { id: "castrol-vecton-long-drain-10w40", name: "Castrol Vecton Long Drain 10W-40", price: 59.99, image: "https://images.unsplash.com/photo-1766561993769-b834c1c6e456?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080", description: "Aceite Castrol Vecton Long Drain para vehículos pesados", viscosity: "10W-40", category: "pesados", brand: "Castrol" },
];
---

<BaseLayout title="Productos - Lubricantes">
    <!-- Hero Section -->
    <section class="w-full bg-gradient-to-b from-[#FFF8F3] to-[#FFF0E5] py-16">
        <div class="max-w-7xl mx-auto px-6">
            <!-- Tag -->
            <div class="flex items-center justify-center gap-2 mb-8">
                <div class="w-2 h-2 rounded-full bg-[#FF6B00]"></div>
                <p class="text-sm font-bold text-[#FF6B00] tracking-widest uppercase">Catálogo 2026</p>
            </div>

            <!-- Hero Title -->
            <h1 class="text-5xl md:text-6xl font-bold text-center text-gray-900 mb-4 leading-tight">
                Encuentra los lubricantes<br/>para tu vehículo
            </h1>

            <!-- Hero Subtitle -->
            <p class="text-center text-gray-600 text-lg mb-12 max-w-2xl mx-auto">
                Selecciona la categoría de tu vehículo y explora nuestro catálogo completo
            </p>

            <!-- Vehicle Selector Panel -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <!-- Moto Card -->
                <div class="relative rounded-2xl overflow-hidden h-96 cursor-pointer group hover:shadow-xl transition-all duration-300 vehicle-selector" data-category="motos">
                    <img
                        src="https://images.unsplash.com/photo-1769138317350-ab1c10e538f1?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080"
                        alt="Motos"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                </div>

                <!-- Vehículos livianos Card -->
                <div class="relative rounded-2xl overflow-hidden h-96 cursor-pointer group hover:shadow-xl transition-all duration-300 vehicle-selector" data-category="livianos">
                    <img
                        src="https://images-cam93.s3.us-east-1.amazonaws.com/crro.jpg"
                        alt="Vehículos livianos"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                </div>

                <!-- Vehículos pesados Card -->
                <div class="relative rounded-2xl overflow-hidden h-96 cursor-pointer group hover:shadow-xl transition-all duration-300 vehicle-selector" data-category="pesados">
                    <img
                        src="https://images.unsplash.com/photo-1766561993769-b834c1c6e456?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=1080"
                        alt="Vehículos pesados"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                </div>
            </div>

            <!-- Gradient divider -->
            <div class="h-1 bg-gradient-to-r from-[#FF6B00] via-[#FFBA80] to-[#FF6B00] rounded-full"></div>
        </div>
    </section>

    <!-- Brand Filter Panel -->
    <section class="w-full bg-[#FF6B00] px-6 py-8">
        <div class="max-w-7xl mx-auto">
            <h3 class="text-2xl font-bold text-white mb-6 text-center">Marcas disponibles</h3>
            <div id="brand-filter-panel" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-9 gap-3 sm:gap-4 md:gap-5 lg:gap-6">
                <!-- Brands will be inserted here by JavaScript -->
            </div>
        </div>
    </section>

    <!-- Category Tabs & Search -->
    <section class="w-full bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-6 py-4 sm:py-6">
            <div class="flex flex-col sm:flex-row flex-wrap items-center gap-3 sm:gap-4 justify-between">
                <!-- Tabs -->
                <div class="flex gap-2 sm:gap-3 flex-wrap w-full sm:w-auto">
                    <button class="category-tab cursor-pointer bg-[#FF6B00] text-white px-3 sm:px-6 py-2 rounded-full font-bold text-xs sm:text-sm hover:bg-[#E55A00] transition-colors flex items-center gap-1 sm:gap-2 active" data-category="motos">
                        <span>🏍️</span>
                        <span class="hidden sm:inline">Motos</span>
                        <span class="sm:hidden">Motos</span>
                    </button>
                    <button class="category-tab cursor-pointer bg-[#FFF0E6] text-[#FF6B00] px-3 sm:px-6 py-2 rounded-full font-bold text-xs sm:text-sm border-2 border-[#FFD4A8] hover:bg-[#FFE8D5] transition-colors flex items-center gap-1 sm:gap-2" data-category="livianos">
                        <span>🚗</span>
                        <span class="hidden lg:inline">Vehículos livianos</span>
                        <span class="lg:hidden">Livianos</span>
                    </button>
                    <button class="category-tab cursor-pointer bg-[#FFF0E6] text-[#FF6B00] px-3 sm:px-6 py-2 rounded-full font-bold text-xs sm:text-sm border-2 border-[#FFD4A8] hover:bg-[#FFE8D5] transition-colors flex items-center gap-1 sm:gap-2" data-category="pesados">
                        <span>🚚</span>
                        <span class="hidden lg:inline">Vehículos pesados</span>
                        <span class="lg:hidden">Pesados</span>
                    </button>
                </div>

                <!-- Search Bar -->
                <div class="relative w-full sm:w-64">
                    <input
                        type="text"
                        placeholder="Buscar..."
                        class="bg-gray-100 text-gray-900 placeholder-gray-500 px-4 py-2 rounded-full text-sm w-full focus:outline-none focus:ring-2 focus:ring-[#FF6B00]"
                    />
                    <span class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-400">🔍</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Catalog Area -->
    <section class="w-full bg-[#FFF8F3] py-12">
        <div class="max-w-7xl mx-auto px-6">
            <div>
                <!-- Main Content -->
                <main class="flex-1">
                    <!-- Brand Indicator -->
                    <div id="brand-indicator" class="mb-6"></div>

                    <!-- Products Grid -->
                    <div id="products-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-8 transition-opacity duration-200">
                        {
                            products.map((product) => (
                                <div class="bg-white rounded-xl overflow-hidden hover:shadow-lg transition-shadow duration-300 group product-item" data-category={product.category} data-brand={product.brand}>
                                    <div class="relative overflow-hidden h-40 sm:h-48 bg-gray-200">
                                        <img
                                            src={product.image}
                                            alt={product.name}
                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                                        />
                                    </div>
                                    <div class="p-4">
                                        <h3 class="font-bold text-gray-900 text-sm mb-2 line-clamp-2">
                                            {product.name}
                                        </h3>
                                        <p class="text-xs text-gray-600 line-clamp-2">
                                            {product.description}
                                        </p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Pagination -->
                    <div class="flex items-center justify-center gap-2">
                        <button class="text-gray-400 font-bold text-sm">←</button>
                        <button class="bg-[#FF6B00] text-white w-8 h-8 rounded font-bold">1</button>
                        <button class="text-gray-600 hover:bg-gray-100 w-8 h-8 rounded font-bold">2</button>
                        <button class="text-gray-400 font-bold text-sm">→</button>
                    </div>
                </main>
            </div>
        </div>
    </section>
<script>
const brands = {
    motos: [
        { name: 'Mobil', logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/3/3d/Mobil_logo.svg/1280px-Mobil_logo.svg.png' },
        { name: 'Castrol', logo: 'https://crystalpng.com/wp-content/uploads/2025/03/castrol-logo.png' },
        { name: 'Motul', logo: 'https://1000logos.net/wp-content/uploads/2020/04/Logo-Motul.png' },
        { name: 'Bajaj', logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/2/2b/Bajaj_Auto_Ltd_logo.svg/1280px-Bajaj_Auto_Ltd_logo.svg.png' },
        { name: 'Yamalube', logo: 'https://images.seeklogo.com/logo-png/17/2/yamalube-logo-png_seeklogo-173930.png' },
        { name: 'Honda', logo: 'https://upload.wikimedia.org/wikipedia/commons/3/38/Honda.svg' },
        { name: 'Liqui Moly', logo: 'https://liqui-moly.com.co/wp-content/uploads/2022/03/LOGO-ACTUAL-2025.png' },
        { name: 'Hero', logo: 'https://images.seeklogo.com/logo-png/17/2/hero-logo-png_seeklogo-170801.png' },
        { name: 'Motorex', logo: 'https://lezebre.lu/images/detailed/15/18971-motorex-oil-logo.png' },
        { name: 'Ipone', logo: 'https://cdn.freebiesupply.com/logos/large/2x/ipone-logo-png-transparent.png' },
        { name: 'ENI', logo: 'https://download.logo.wine/logo/Eni/Eni-Logo.wine.png' },
        { name: 'Shell', logo: 'https://upload.wikimedia.org/wikipedia/en/thumb/e/e8/Shell_logo.svg/1280px-Shell_logo.svg.png' },
        { name: 'Repsol', logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/e/e8/Repsol_logo.svg/1280px-Repsol_logo.svg.png' },
        { name: 'Ecstar', logo: 'https://cdn.shopify.com/s/files/1/0733/5752/5215/files/ecstar-suzuki.svg?v=1736021458' },
        { name: 'Terpel', logo: 'https://portalcolombia.terpel.com/static/images/terpel_logo_og.png' },
        { name: 'Delta Oil', logo: 'https://deltaoil.co/wp-content/uploads/2023/03/logo-Delta-express-rojo.png' },
        { name: 'ELF', logo: 'https://elf.co/themes/custom/butterfly_theme/elf-logo.svg?v=1.1' },
        { name: 'Pysta', logo: 'https://pysta.co/cdn/shop/files/Encabezado.png?height=628&pad_color=ffffff&v=1735855211&width=1200' }
    ],
    livianos: [
        { name: 'Mobil', logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/3/3d/Mobil_logo.svg/1280px-Mobil_logo.svg.png' },
        { name: 'Castrol', logo: 'https://crystalpng.com/wp-content/uploads/2025/03/castrol-logo.png' },
        { name: 'ELF', logo: 'https://elf.co/themes/custom/butterfly_theme/elf-logo.svg?v=1.1' }
    ],
    pesados: [
        { name: 'Mobil', logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/3/3d/Mobil_logo.svg/1280px-Mobil_logo.svg.png' },
        { name: 'Castrol', logo: 'https://crystalpng.com/wp-content/uploads/2025/03/castrol-logo.png' }
    ]
};

let currentCategory = 'motos';
let currentBrand = null;

function renderBrands(category) {
    const filterPanel = document.querySelector('#brand-filter-panel');

    // Clear previous brands but keep the grid class
    const brandButtons = filterPanel.querySelectorAll('.brand-selector');
    brandButtons.forEach(btn => btn.remove());

    const categoryBrands = brands[category] || [];

    categoryBrands.forEach(brand => {
        const brandButton = document.createElement('button');
        brandButton.className = 'brand-selector cursor-pointer flex items-center justify-center p-4 rounded-xl bg-white/20 hover:bg-white/40 transition-all duration-300 group';
        brandButton.setAttribute('data-brand', brand.name);
        brandButton.setAttribute('title', brand.name);
        brandButton.innerHTML = `
            <img src="${brand.logo}" alt="${brand.name}" class="h-16 w-16 object-contain" />
        `;

        brandButton.addEventListener('click', function() {
            filterByBrand(brand.name, brand.logo);
            document.querySelectorAll('.brand-selector').forEach(b => b.classList.remove('ring-4', 'ring-white'));
            this.classList.add('ring-4', 'ring-white');
        });

        filterPanel.appendChild(brandButton);
    });
}

function filterByBrand(brand, logo) {
    currentBrand = brand;
    const productItems = document.querySelectorAll('.product-item');
    const productsContainer = document.getElementById('products-container');

    // Update brand indicator
    const brandIndicator = document.getElementById('brand-indicator');
    if (brandIndicator && logo) {
        brandIndicator.innerHTML = `
            <div class="flex items-center gap-3">
                <span class="text-sm text-gray-600">Filtrando por:</span>
                <img src="${logo}" alt="${brand}" class="h-10 w-10 object-contain" />
            </div>
        `;
    }

    productsContainer.style.opacity = '0.5';

    setTimeout(() => {
        productItems.forEach(item => {
            const itemCategory = item.getAttribute('data-category');
            const itemBrand = item.getAttribute('data-brand');

            if (itemCategory === currentCategory && itemBrand === brand) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });

        productsContainer.style.opacity = '1';
    }, 200);
}

document.addEventListener('DOMContentLoaded', function() {
    // Vehicle selectors
    const vehicleSelectors = document.querySelectorAll('.vehicle-selector');
    const productItems = document.querySelectorAll('.product-item');
    const productsContainer = document.getElementById('products-container');

    vehicleSelectors.forEach(selector => {
        selector.addEventListener('click', function() {
            currentCategory = this.getAttribute('data-category');
            currentBrand = null;

            productsContainer.style.opacity = '0.5';

            setTimeout(() => {
                // No mostrar productos hasta que se seleccione una marca
                productItems.forEach(item => {
                    item.style.display = 'none';
                });

                // Limpiar indicador de marca
                const brandIndicator = document.getElementById('brand-indicator');
                if (brandIndicator) {
                    brandIndicator.innerHTML = '';
                }

                productsContainer.style.opacity = '1';
            }, 200);

            // Render brands for this category
            renderBrands(currentCategory);
        });
    });

    // Category tabs
    const categoryTabs = document.querySelectorAll('.category-tab');
    categoryTabs.forEach(tab => {
        tab.addEventListener('click', function() {
            categoryTabs.forEach(t => {
                t.classList.remove('bg-[#FF6B00]', 'text-white');
                t.classList.add('bg-[#FFF0E6]', 'text-[#FF6B00]', 'border-2', 'border-[#FFD4A8]');
            });

            this.classList.remove('bg-[#FFF0E6]', 'text-[#FF6B00]', 'border-2', 'border-[#FFD4A8]');
            this.classList.add('bg-[#FF6B00]', 'text-white');

            currentCategory = this.getAttribute('data-category');
            currentBrand = null;

            productsContainer.style.opacity = '0.5';

            setTimeout(() => {
                // No mostrar productos hasta que se seleccione una marca
                productItems.forEach(item => {
                    item.style.display = 'none';
                });

                // Limpiar indicador de marca
                const brandIndicator = document.getElementById('brand-indicator');
                if (brandIndicator) {
                    brandIndicator.innerHTML = '';
                }

                productsContainer.style.opacity = '1';
            }, 200);

            renderBrands(currentCategory);
        });
    });

    // Initial render
    renderBrands('motos');
});
</script>
</BaseLayout>
