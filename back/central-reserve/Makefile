# Makefile para Central Reserve Backend
# Uso: make [comando]

.PHONY: help build run test clean docker-build docker-dev docker-prod docker-stop docker-logs

# Variables
APP_NAME=central_reserve
DOCKER_IMAGE=central-reserve
DOCKER_TAG=latest

# Comandos principales
help: ## Mostrar esta ayuda
	@echo "Comandos disponibles:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'

# Desarrollo local
build: ## Compilar la aplicación
	go build -o bin/$(APP_NAME) ./cmd/main.go

run: ## Ejecutar la aplicación localmente
	go run ./cmd/main.go

test: ## Ejecutar tests
	go test ./...

clean: ## Limpiar archivos generados
	rm -rf bin/
	go clean

# Docker
docker-build: ## Construir imagen Docker
	docker build -f docker/Dockerfile -t $(DOCKER_IMAGE):$(DOCKER_TAG) .

docker-dev: ## Levantar entorno de desarrollo con Docker
	@echo "🚀 Levantando entorno de desarrollo..."
	cd docker && docker-compose -f docker-compose.dev.yml up -d
	@echo "✅ Entorno listo!"
	@echo "📋 Servicios disponibles:"
	@echo "  - API: http://localhost:3050"
	@echo "  - Swagger: http://localhost:3050/docs"
	@echo "  - NATS Dashboard: http://localhost:8111"
	@echo "  - Adminer: http://localhost:8080"

docker-prod: ## Levantar entorno de producción con Docker
	@echo "🚀 Levantando entorno de producción..."
	cd docker && docker-compose -f docker-compose.prod.yml up -d
	@echo "✅ Entorno de producción listo!"

docker-stop: ## Detener contenedores Docker
	@echo "🛑 Deteniendo contenedores..."
	cd docker && docker-compose -f docker-compose.dev.yml down
	cd docker && docker-compose -f docker-compose.prod.yml down

docker-logs: ## Ver logs de la aplicación
	cd docker && docker-compose -f docker-compose.dev.yml logs -f central_reserve

docker-logs-all: ## Ver logs de todos los servicios
	cd docker && docker-compose -f docker-compose.dev.yml logs -f

# Scripts automatizados
build-and-run: ## Build y ejecutar con script automatizado
	./scripts/build-docker.sh dev

build-prod: ## Build para producción
	./scripts/build-docker.sh prod

# Utilidades
deps: ## Instalar dependencias
	go mod tidy
	go mod download

docs: ## Generar documentación completa (todos los módulos)
	swag init -g ./cmd/main.go --output ./shared/docs --parseDependency --parseInternal --exclude services/reserve --exclude services/restaurants

docs-auth: ## Generar documentación solo para módulo Auth
	@echo "Generando documentación completa..."
	@swag init -g ./cmd/main.go --output ./shared/docs --parseDependency --parseInternal --exclude services/reserve --exclude services/restaurants
	@echo "Filtrando rutas de auth..."
	@cat shared/docs/swagger.json | jq '{swagger, info, host, basePath, schemes, paths: (.paths | with_entries(select(.key | test("^/(actions|auth|users|roles|permissions|resources|business-types|businesses|dashboard|logs)")))), definitions, securityDefinitions}' > shared/docs/auth/swagger.json
	@echo "Generando docs.go desde swagger.json filtrado..."
	@python3 -c "import json; d=json.load(open('shared/docs/auth/swagger.json')); s=json.dumps(d,ensure_ascii=False); s=s.replace('\`', '\` + \"\`\" + \`'); s=s.replace('{{', '{{\"{{\"}}'); s=s.replace('}}', '{{\"}}\"}}'); open('shared/docs/auth/docs.go','w').write(f'''// Package auth Code generated by swaggo/swag. DO NOT EDIT\npackage auth\n\nimport \"github.com/swaggo/swag\"\n\nconst docTemplate = \`{s}\`\n\nvar SwaggerInfo = &swag.Spec{{\n\tVersion: \"{d[\"info\"][\"version\"]}\",\n\tHost: \"{d.get(\"host\", \"localhost:3050\")}\",\n\tBasePath: \"{d.get(\"basePath\", \"/api/v1\")}\",\n\tSchemes: []string{{}},\n\tTitle: \"Auth API\",\n\tDescription: \"API para la gestión de autenticación, usuarios, roles y permisos.\",\n\tInfoInstanceName: \"auth\",\n\tSwaggerTemplate: docTemplate,\n\tLeftDelim: \"{{{{\",\n\tRightDelim: \"}}}}\",\n}}\n\nfunc init() {{\n\tswag.Register(SwaggerInfo.InstanceName(), SwaggerInfo)\n}}\n''')"
	@echo "Documentación de auth generada correctamente"

docs-properties: ## Generar documentación solo para módulo Properties (horizontalproperty)
	@echo "Generando documentación completa..."
	@swag init -g ./cmd/main.go --output ./shared/docs --parseDependency --parseInternal --exclude services/reserve --exclude services/restaurants
	@echo "Filtrando rutas de properties..."
	@cat shared/docs/swagger.json | jq '{swagger, info, host, basePath, schemes, paths: (.paths | with_entries(select(.key | test("horizontal|attendance|resident|voting|property|public|visit")))), definitions, securityDefinitions}' > shared/docs/properties/swagger.json
	@echo "Generando docs.go desde swagger.json filtrado..."
	@python3 -c "import json; d=json.load(open('shared/docs/properties/swagger.json')); s=json.dumps(d,ensure_ascii=False); s=s.replace('\`', '\` + \"\`\" + \`'); s=s.replace('{{', '{{\"{{\"}}'); s=s.replace('}}', '{{\"}}\"}}'); open('shared/docs/properties/docs.go','w').write(f'''// Package properties Code generated by swaggo/swag. DO NOT EDIT\npackage properties\n\nimport \"github.com/swaggo/swag\"\n\nconst docTemplate = \`{s}\`\n\nvar SwaggerInfo = &swag.Spec{{\n\tVersion: \"{d[\"info\"][\"version\"]}\",\n\tHost: \"{d.get(\"host\", \"localhost:3050\")}\",\n\tBasePath: \"{d.get(\"basePath\", \"/api/v1\")}\",\n\tSchemes: []string{{}},\n\tTitle: \"Properties API\",\n\tDescription: \"API para la gestión de propiedades horizontales.\",\n\tInfoInstanceName: \"properties\",\n\tSwaggerTemplate: docTemplate,\n\tLeftDelim: \"{{{{\",\n\tRightDelim: \"}}}}\",\n}}\n\nfunc init() {{\n\tswag.Register(SwaggerInfo.InstanceName(), SwaggerInfo)\n}}\n''')"
	@echo "Documentación de properties generada correctamente"

docs-all: docs-auth docs-properties ## Generar documentación separada para ambos módulos

# Base de datos
db-migrate: ## Ejecutar migraciones de base de datos
	@echo "📊 Ejecutando migraciones..."
	# Aquí puedes agregar comandos para migraciones si las tienes

db-reset: ## Resetear base de datos (¡CUIDADO!)
	@echo "⚠️  Reseteando base de datos..."
	cd docker && docker-compose -f docker-compose.dev.yml down -v
	cd docker && docker-compose -f docker-compose.dev.yml up -d postgres

# Email testing
test-email: ## Probar envío de emails
	go run examples/email-starttls-test.go

# Health check
health: ## Verificar salud de los servicios
	@echo "🏥 Verificando salud de servicios..."
	@curl -f http://localhost:3050/health || echo "❌ API no responde"
	@curl -f http://localhost:8111 || echo "❌ NATS Dashboard no responde"

# Limpieza completa
clean-all: ## Limpieza completa (Docker + binarios)
	@echo "🧹 Limpieza completa..."
	make clean
	make docker-stop
	docker system prune -f
	docker volume prune -f

# Información del sistema
info: ## Mostrar información del sistema
	@echo "📊 Información del sistema:"
	@echo "  - Go version: $(shell go version)"
	@echo "  - Docker version: $(shell docker --version)"
	@echo "  - Docker Compose version: $(shell docker-compose --version)"
	@echo "  - Contenedores activos:"
	@docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" | grep -E "(central_reserve|postgres|redis|nats)" || echo "  No hay contenedores activos" 