# Configuración para testing de integración

# URL base de la API
# Default: http://localhost:8081/api/v1
API_BASE_URL=http://localhost:8081/api/v1

# Credenciales de usuario para testing
# Debe existir un usuario con estas credenciales en la base de datos
# Default: admin@test.com / admin123
TEST_USER_EMAIL=admin@test.com
TEST_USER_PASSWORD=admin123
